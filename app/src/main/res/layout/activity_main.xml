<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Home is deliberately non-scrolling: the artwork flexes so all actions stay visible. -->
    <LinearLayout android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/home_cave_continuation">
        <com.endralink.app.ArtworkView android:id="@+id/homeArtwork"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:baselineAligned="false">
            <Button android:id="@+id/homeFx" style="@style/TechButtonPrimary" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="62dp" android:minHeight="0dp"
                android:text="fx-CG50" android:contentDescription="Open fx-CG50 workspace"/>
            <Button android:id="@+id/homeNspire" style="@style/TechButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="62dp" android:minHeight="0dp"
                android:layout_marginStart="5dp" android:text="TI-Nspire\nComing later" android:textSize="11sp" android:enabled="false"/>
            <Button android:id="@+id/homePrime" style="@style/TechButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="62dp" android:minHeight="0dp"
                android:layout_marginStart="5dp" android:text="HP Prime\nComing later" android:textSize="11sp" android:enabled="false"/>
        </LinearLayout>
        <Button android:id="@+id/homeDonate" style="@style/TechButtonPrimary"
            android:layout_width="match_parent" android:layout_height="62dp" android:minHeight="0dp"
            android:layout_marginStart="@dimen/screen_gutter" android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_marginTop="2dp" android:text="♡  DONATE"/>
        <TextView android:id="@+id/homeVersion" android:layout_width="match_parent" android:layout_height="28dp"
            android:gravity="center" android:text="EndraLink" android:textColor="@color/muted" android:textSize="10sp"/>
    </LinearLayout>

    <ScrollView android:id="@+id/workspacePage" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/workspace_background" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="30dp"
            android:paddingEnd="30dp" android:paddingTop="6dp" android:paddingBottom="20dp"
            android:gravity="center_horizontal">
            <Button android:id="@+id/homeBack" style="@style/TechButton" android:layout_width="82dp" android:layout_height="40dp" android:layout_gravity="end" android:minHeight="0dp" android:minWidth="0dp" android:gravity="center" android:includeFontPadding="true" android:padding="0dp" android:text="HOME" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <com.endralink.app.ArtworkView android:id="@+id/workspaceHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="fx-CG50  •  FILE TRANSFER" android:gravity="center" android:textStyle="bold" android:textSize="15sp" android:letterSpacing="0.08" android:textColor="@color/cyan"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:background="@drawable/panel" android:padding="8dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USB CONNECTION"
                    android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/muted"/>
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Connect your fx-CG50" android:textSize="17sp"
                    android:textStyle="bold" android:textColor="@color/silver" android:accessibilityLiveRegion="polite"/>
                <TextView android:id="@+id/deviceDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="Use USB Flash mode on the calculator."
                    android:textColor="@color/muted" android:textSize="13sp"/>
                <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
                    android:indeterminateTint="@color/cyan" android:visibility="gone"/>
                <Button android:id="@+id/connect" style="@style/TechButtonPrimary" android:layout_width="match_parent"
                    android:layout_height="44dp" android:minHeight="0dp" android:padding="4dp" android:textSize="13sp" android:layout_marginTop="4dp" android:text="Connect fx-CG50"/>
                <Button android:id="@+id/browse" style="@style/TechButton" android:layout_width="match_parent"
                    android:layout_height="44dp" android:minHeight="0dp" android:padding="4dp" android:textSize="13sp" android:text="Browse calculator" android:enabled="false"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/browserPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:background="@drawable/panel" android:padding="16dp"
                android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/storageInfo" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:textColor="@color/cyan" android:textSize="12sp"/>
                    <Button android:id="@+id/collapseBrowser" style="@style/TechButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collapse"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/browserBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/folderPath" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="/" android:textSize="18sp" android:textColor="@color/silver"/>
                    <Button android:id="@+id/upFolder" style="@style/TechButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Parent folder"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/newCalcFile" style="@style/TechButton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="New file"/>
                        <Button android:id="@+id/newCalcFolder" style="@style/TechButton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="New folder"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/fileList" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/transferPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/panel" android:padding="6dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ENDRALINK PHONE FILE MANAGER" android:textStyle="bold" android:textSize="11sp"
                    android:letterSpacing="0.12" android:textColor="@color/muted"/>
                <LinearLayout android:id="@+id/phoneStorageBody" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <Button android:id="@+id/openPhone" style="@style/TechButton"
                        android:layout_width="match_parent" android:layout_height="44dp" android:minHeight="0dp" android:padding="4dp" android:textSize="12sp" android:text="Choose phone folder"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                        <Button android:id="@+id/phoneUp" style="@style/TechButton" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="42dp" android:minHeight="0dp" android:padding="2dp" android:textSize="11sp" android:text="Up" android:enabled="false"/>
                        <Button android:id="@+id/clearQueue" style="@style/TechButton" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="42dp" android:minHeight="0dp" android:padding="2dp" android:textSize="11sp" android:layout_marginStart="5dp" android:text="Clear" android:enabled="false"/>
                        <Button android:id="@+id/collapsePhoneStorage" style="@style/TechButton" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="42dp" android:minHeight="0dp" android:padding="2dp" android:textSize="10sp" android:layout_marginStart="5dp" android:text="Collapse"/>
                    </LinearLayout>
                    <TextView android:id="@+id/phonePath" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Grant a phone folder once, then browse it here." android:textColor="@color/cyan"
                        android:paddingTop="6dp" android:paddingBottom="6dp"/>
                    <LinearLayout android:id="@+id/phoneFileBrowser" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
                <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No files or folders selected" android:textColor="@color/muted"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <LinearLayout android:id="@+id/localFileList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
                <ProgressBar android:id="@+id/transferProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp" android:indeterminate="true"
                    android:indeterminateTint="@color/cyan" android:visibility="gone"/>
                <Button android:id="@+id/copy" style="@style/TechButtonPrimary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Transfer selected items" android:enabled="false"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp" android:background="#E603101B" android:padding="2dp">
                <Button android:id="@+id/eject" style="@style/TechButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="40dp" android:minHeight="0dp" android:textSize="11sp" android:padding="0dp" android:gravity="center" android:text="Eject calculator" android:enabled="false"/>
                <Button android:id="@+id/exportLog" style="@style/TechButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="40dp" android:minHeight="0dp" android:textSize="11sp" android:padding="0dp" android:gravity="center" android:layout_marginStart="6dp"
                    android:text="Export debug log"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Two-way EndraLink file manager enabled. Existing files require confirmation before overwrite."
                android:textSize="10sp" android:gravity="center" android:textColor="@color/muted" android:paddingBottom="5dp"/>
            <com.endralink.app.ArtworkView android:id="@+id/workspaceFooter"
                android:layout_width="match_parent" android:layout_height="48dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
